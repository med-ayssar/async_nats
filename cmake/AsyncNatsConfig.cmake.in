@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Boost 1.90 REQUIRED CONFIG COMPONENTS cobalt)
find_dependency(spdlog REQUIRED)
find_dependency(OpenSSL REQUIRED)
find_dependency(cnats CONFIG REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/AsyncNatsTargets.cmake")

# ON unless this package was built with -DwithMain=OFF or -DASYNC_NATS_WITH_MAIN=OFF.
# When ON, the archive defines main and calls the application's co_main.
set(ASYNC_NATS_WITH_MAIN @ASYNC_NATS_WITH_MAIN@)

check_required_components(AsyncNats)
